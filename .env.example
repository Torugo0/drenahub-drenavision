# Paths are resolved from the repository root unless absolute.
DRENAVISION_MODEL_PATH=artifacts/models/best.pt
DRENAVISION_DATABASE_PATH=artifacts/events/drenavision.db
DRENAVISION_EVIDENCE_DIR=artifacts/events/evidence

# Inference and upload controls.
DRENAVISION_CONFIDENCE_THRESHOLD=0.35
DRENAVISION_IOU_THRESHOLD=0.45
DRENAVISION_DEVICE=auto
DRENAVISION_MAX_IMAGE_BYTES=12582912
DRENAVISION_MAX_VIDEO_BYTES=524288000
DRENAVISION_MAX_IMAGE_PIXELS=40000000
DRENAVISION_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

